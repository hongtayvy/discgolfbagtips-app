# Leave unset in development: requests go to the same origin and Vite proxies
# /api to the backend (API_TARGET, default http://localhost:8080).
# Set this only when the API is served from another origin in production.
# VITE_API_BASE_URL=https://api.discgolfbagtips.com

# Where the dev proxy forwards /api. Defaults to http://localhost:8080.
# API_TARGET=http://localhost:8080

# --- Sign-in (Supabase) -----------------------------------------------------
# Leave both unset to run without accounts: no Sign in button appears and saved
# bags stay on the API's cookie session. The anon key is public by design —
# Supabase's row-level security is what protects data, not this key.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Show "Continue with Google". Enable Google as a provider in the Supabase
# dashboard (Authentication -> Providers) first, or the button will error.
# VITE_AUTH_GOOGLE=true

# The "By continuing, you agree to…" line appears only when both pages exist.
# VITE_TERMS_URL=https://discgolfbagtips.com/terms
# VITE_PRIVACY_URL=https://discgolfbagtips.com/privacy
